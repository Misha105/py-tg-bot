# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=

# OpenRouter API key required. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model (format: provider/model)
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# HTTP Referer header for OpenRouter analytics
OPENROUTER_REFERER=https://github.com/your-org/telegram-bot

# App title for OpenRouter usage tracking
OPENROUTER_TITLE=Telegram LLM Bot

# Comma-separated list of allowed Telegram user IDs (empty = allow all)
ALLOWED_USER_IDS=

# Path to system prompt markdown file
SYSTEM_PROMPT_PATH=prompts/system.md

# Maximum number of messages to keep in conversation history
MAX_HISTORY_MESSAGES=10

# Response timeout in seconds
RESPONSE_TIMEOUT=120

# MIGRATION NOTE:
# 1. Move your system prompt from .env to prompts/system.md
# 2. Remove SYSTEM_PROMPT from .env if it exists
# 3. Bot will auto-load from SYSTEM_PROMPT_PATH on startup
# 4. Fallback is used if file is missing or unreadable
