# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=

# OpenRouter API key required. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model (format: provider/model)
OPENROUTER_DEFAULT_MODEL=openrouter/owl-alpha

# HTTP Referer header for OpenRouter analytics
OPENROUTER_REFERER=

# App title for OpenRouter usage tracking
OPENROUTER_TITLE=

# Comma-separated list of allowed Telegram user IDs (empty = allow all)
ALLOWED_USER_IDS=

# Path to system prompt markdown file
SYSTEM_PROMPT_PATH=prompts/system.md

# Maximum number of messages to keep in conversation history
MAX_HISTORY_MESSAGES=10

# Maximum input length in characters
MAX_INPUT_LENGTH=4000

# Response timeout in seconds
RESPONSE_TIMEOUT=120

# --- Sampling Parameters ---

# Temperature (0.0-2.0): Higher = more creative, lower = more focused
TEMPERATURE=0.7

# Top P (0.0-1.0): Nucleus sampling threshold
TOP_P=0.9

# Max completion tokens: Upper limit for generated response
MAX_COMPLETION_TOKENS=1024

# Presence penalty (-2.0 to 2.0): Reduces repetition of ideas
PRESENCE_PENALTY=0.3

# Frequency penalty (-2.0 to 2.0): Reduces repetition based on token frequency
FREQUENCY_PENALTY=0.0

# Verbosity (low, medium, high): Controls response detail level
VERBOSITY=low
